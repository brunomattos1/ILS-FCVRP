        - function randomFamiliarSwap!(solver::Solver)
        0     sol = solver.currSol
        -     r, i, outer = 0, 0, 0
        -     loop = true
        0     while loop
        -         loop = false
        0         r = rand(solver.seed, 1:length(sol.routes))
        0         if length(sol.routes[r]) <= 2
        -             loop = true
        -         else
        0             i = rand(solver.seed, 2:length(sol.routes[r])-1)
        0             family = solver.data.vertices[sol.routes[r][i]].family
        0             if length(sol.notVisited[family]) == 0
        -                 loop = true
        -             else
        0                 outer = rand(solver.seed, sol.notVisited[family])
        -             end
        -         end
        0     end
        0     dist = evalFamiliarSwap(sol.dist, sol.routes, solver, r, i, outer)
        0     capViol, minVisitsViol, maxVisitsViol = computeViolFamiliarSwap(solver, r, i, outer)
        0     penalizedCost = dist + solver.params.capPenalty*(sol.capViolation - sol.routeCapViolation[r] + capViol)
        0     penalizedCost += solver.params.minVisitsPenalty*(sol.minVisitsViolation - sol.routeMinVisitsViolation[r] + minVisitsViol)
        0     penalizedCost += solver.params.maxVisitsPenalty*(sol.maxVisitsViolation - sol.routeMaxVisitsViolation[r] + maxVisitsViol)
        0     applyMoveFamiliarSwap(solver, dist, penalizedCost, capViol, minVisitsViol, maxVisitsViol, r, i, outer)
        0     return true
        - end
