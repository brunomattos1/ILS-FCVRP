        - function perturb!(solver::Solver)
        0     rnd = rand(solver.seed)
        -     # if rnd <= 0.1
        -     #     randomTwoOpt!(solver)
        0     if rnd <= 0.3
        0         for _ = 1:solver.diversification.swap
        0             perturbed = randomInterSwap11!(solver)
        0         end
        0     elseif rnd <= 0.6
        0         for _ = 1:solver.diversification.shift
        0             perturbed = randomInterShit10!(solver)
        0         end
        -     else
        0         for _ = 1:2
        0             perturbed = randomFamiliarSwap!(solver)
        0         end
        -     end
        - end
