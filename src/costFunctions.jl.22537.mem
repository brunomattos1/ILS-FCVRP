        - 
        - """
        -     evalFamiliarRelocate(currCost, routes, solver, r1, i_remove, r2, j_insert, outer)
        - 
        - Retorna o novo custo total após remover o cliente `routes[r1][i_remove]` da rota `r1`
        - e inserir o cliente `outer` antes da posição `j_insert` da rota `r2`.
        - 
        - Se `r1 == r2`, o caso é tratado corretamente (inclusive inserção adjacente).
        - Cálculo em O(1).
        - """
        - function familiarRelocateSwapCost(currCost::Float64, routes::Vector{Vector{Int}}, costMatrix::Matrix{Float64},
        -                               r1::Int, i_remove::Int, r2::Int, j_insert::Int, outer::Int)
        -     d = costMatrix
        0     route1 = routes[r1]
        0     route2 = routes[r2]
        - 
        0     v = route1[i_remove] + 1
        0     p_rem = route1[i_remove - 1] + 1
        0     s_rem = route1[i_remove + 1] + 1
        - 
        -     Δ = 0.0
        - 
        0     if r1 != r2
        0         a_ins = route2[j_insert - 1] + 1
        0         b_ins = route2[j_insert] + 1
        0         newCost = currCost - d[p_rem, v] - d[v, s_rem] - d[a_ins, b_ins] + d[p_rem, s_rem] + d[a_ins, outer+1] + d[outer+1, b_ins]
        0         return newCost
        - 
        -     else
        -         # --- Caso 2: mesma rota ---
        -         r = route1
        -         n = length(r)
        - 
        0         if j_insert == i_remove
        -             # substituição direta
        0             Δ = -d[p_rem, v] - d[v, s_rem] + d[p_rem, outer+1] + d[outer+1, s_rem]
        - 
        0         elseif j_insert < i_remove
        -             # inserção antes
        0             a = r[j_insert - 1]+1
        0             b = r[j_insert]+1
        0             if j_insert + 1 == i_remove
        -                 # inserção imediatamente antes do removido
        0                 Δ = -d[a, b] - d[b, v] - d[v, s_rem] + d[a, outer+1] + d[outer+1, b] + d[b, s_rem]
        -             else
        0                 Δ_insert = -d[a, b] + d[a, outer+1] + d[outer+1, b]
        0                 Δ_remove = -d[p_rem, v] - d[v, s_rem] + d[p_rem, s_rem]
        0                 Δ = Δ_insert + Δ_remove
        -             end
        - 
        -         else
        -             # inserção depois
        0             a = r[j_insert - 1]+1
        0             b = r[j_insert]+1
        0             if j_insert - 1 == i_remove
        -                 # inserção imediatamente depois do removido
        0                 Δ = -d[p_rem, v] - d[v, b] + d[p_rem, outer+1] + d[outer+1, b]
        -             else
        0                 Δ_insert = -d[a, b] + d[a, outer+1] + d[outer+1, b]
        0                 Δ_remove = -d[p_rem, v] - d[v, s_rem] + d[p_rem, s_rem]
        0                 Δ = Δ_insert + Δ_remove
        -             end
        -         end
        -     end
        - 
        0     return currCost + Δ
        - end
