        - function constructSol!(solver::Solver)
        -     # clarkeWright(solver)
        -     # bestParallelInsertion(solver)
        -     if rand(solver.seed) <= 1.5
        -         bestParallelInsertion(solver)
        -     else
        -         clarkeWright(solver)
        -     end
        - end
