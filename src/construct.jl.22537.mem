        - function clarkeWright(solver::Solver)
        0     vertices = copy(solver.data.vertices)
        0     costMatrix = getCostMatrix(solver)
        -     depot = 0  # assumindo 0 como depósito
        - 
        -     # Filtrar clientes (excluir depot se estiver na lista)
        0     customers = [v.id for v in vertices if v.id != depot]
        - 
        -     # Inicializar estruturas
        0     routes = Dict{Int, Vector{Int}}()  # rotas (chave = primeiro cliente da rota)
        0     node_to_route = Dict{Int, Int}()   # mapeamento nó -> chave da rota que pertence
        - 
        -     # 1. Fase de Inicialização: uma rota por cliente [depot -> cliente -> depot]
        0     for c in customers
        0         route = [depot, c, depot]
        0         routes[c] = route          # chave = ID do primeiro cliente
        0         node_to_route[c] = c       # cada nó inicialmente em sua própria rota
        0     end
        - 
        -     # 2. Fase de Cálculo de Savings
        0     σ = rand(solver.seed)
        0     savings = [(i, j, costMatrix[depot+1, i+1] + costMatrix[depot+1, j+1] - σ*costMatrix[i+1, j+1])
        -               for i in customers for j in customers if i < j]
        0     sort!(savings, by = x -> -x[3])  # ordenar por savings decrescente
        - 
        -     # 3. Fase de Junção de Rotas
        0     for (i, j, s) in savings
        0         route_i_key = node_to_route[i]
        0         route_j_key = node_to_route[j]
        - 
        -         # Se já estão na mesma rota, pule
        0         route_i_key == route_j_key && continue
        - 
        0         r_i = routes[route_i_key]
        0         r_j = routes[route_j_key]
        - 
        -         # Verificar posições dos nós nas rotas
        0         i_is_first = (r_i[2] == i)
        0         i_is_last = (r_i[end-1] == i)
        0         j_is_first = (r_j[2] == j)
        0         j_is_last = (r_j[end-1] == j)
        - 
        -         # Tentar combinações válidas de junção
        -         new_route = nothing
        0         if i_is_last && j_is_first
        0             new_route = vcat(r_i[1:end-1], r_j[2:end])
        0         elseif j_is_last && i_is_first
        0             new_route = vcat(r_j[1:end-1], r_i[2:end])
        0         elseif i_is_last && j_is_last
        0             new_route = vcat(r_i[1:end-1], reverse(r_j[2:end-1]), [depot])
        0         elseif i_is_first && j_is_first
        0             new_route = vcat([depot], reverse(r_j[2:end-1]), r_i[2:end])
        -         else
        -             continue  # não é possível juntar
        -         end
        - 
        -         # Verificar restrição de risco
        0         computeViolation(solver, new_route) > 0 && continue
        - 
        -         # Atualizar estruturas de dados
        0         new_key = min(route_i_key, route_j_key)
        0         old_key = new_key == route_i_key ? route_j_key : route_i_key
        - 
        -         # Atualizar rotas
        0         delete!(routes, old_key)
        0         routes[new_key] = new_route
        - 
        -         # Atualizar mapeamento de nós para rotas
        0         for node in new_route[2:end-1]  # excluir depots
        0             node_to_route[node] = new_key
        0         end
        0     end
        -     # 4. Transferir rotas para a Solution
        0     solver.currSol = Solution()
        0     currSol = solver.currSol
        - 
        0     for (_, route) in routes
        0         push!(currSol.routes, route)
        -         # Calcular custo total da rota
        -         route_cost = 0
        0         for k in 1:length(route)-1
        0             route_cost += costMatrix[route[k]+1, route[k+1]+1]
        0         end
        0         currSol.cost += route_cost
        -         # Calcular violação
        0         push!(currSol.routeViolation, computeViolation(solver, route))
        -     end
        - 
        0     return solver.currSol
        - end
